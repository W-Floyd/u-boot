# fogona: 2s, not 0. process_button_cmds() (common/main.c) samples the
# buttons exactly once, so a live GPIO key is only caught if you happen to be
# holding it at that instant -- volume-down survives it because the PON block
# latches in hardware, volume-up does not. The autoboot delay gives a real
# window in which button-kbd (an stdin device here) can interrupt, which
# matters more now that there is no FIT fallback to catch a bad rootfs boot.
bootdelay=2
# fogona: do NOT retry. bootretry re-runs bootcmd every second, which scrolls
# the failure messages off the panel before they can be read.
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
fastboot=fastboot -l $fastboot_addr_r usb 0

# Always probe for UFS storage, though it should be done by board code.

# Shortcut to enable USB serial gadget and disable bootretry
serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

# bootretry will run this command over and over, if we fail once
# then bail out to the boot menu instead (with a pause to read
# the error message)
bootcmd=bootefi bootmgr; pause; run menucmd

# When entering the menu (either from button press or failed boot)
# remap bootcmd so it will re-open the menu and we won't get stuck
# at the console with no way to type
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Pause is used so the output can be read on the display
bootmenu_0=Boot=bootefi bootmgr; pause
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_3=Enable fastboot mode=echo "Press any key to exit fastboot mode"; run fastboot
# Disabling bootretry means we'll just drop the shell
bootmenu_4=Drop to shell=setenv bootretry -1
bootmenu_5=Reset device=reset
bootmenu_6=Dump clocks=clk dump; pause
bootmenu_7=Dump environment=printenv; pause
bootmenu_8=Board info=bdinfo; pause
bootmenu_9=Dump bootargs=fdt addr $fdt_addr_r; fdt print /chosen bootargs; pause
bootmenu_10=Power off=poweroff

# Allow holding the volume down button while U-Boot loads to enter
# the boot menu
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd

# fogona bringup: no serial console and only one key on TLMM, so come up as a
# USB fastboot device unconditionally. Gives a control channel plus a log dump
# via `fastboot oem console` (CONSOLE_RECORD is enabled above).
# fogona bringup: boot the FIT that ABL loaded as the boot image's ramdisk.
#
# NOT ramdisk_addr_r -- board_late_init() sets that to an lmb_alloc'd scratch
# region for U-Boot to load things INTO, unrelated to where the previous stage
# put anything. ABL records the real location in the device tree it hands us,
# as /chosen/linux,initrd-start, so read it from our own fdt.
#
# This route needs no storage, no USB and no regulator control, none of which
# U-Boot has on khaje (its rails are RPM/SMD; U-Boot only ships RPMh).
# ---------------------------------------------------------------- boot paths
# Tried in order: rootfs, then the welded FIT, then fastboot. Each falls
# through to the next only if it fails; a successful boot never returns.
#
# `&&` throughout the load chains, deliberately: CONFIG_HUSH_PARSER makes `;`
# a plain separator that does NOT stop on failure, so a `;` chain would run
# booti on a half-loaded kernel.
# NB: not 'fdtfile' -- qcom board code overwrites that from the DT compatible
# at runtime (it became qcom/sm6115-motorola-fogona.dtb and the load failed).
bootdtb=sm6225-motorola-fogona-icnl9916c.dtb

# Primary: kernel, initramfs and DTB from pmOS's /boot -- ${bootpart}, the
# partition preboot found it on (see "where pmOS is" below).
#
# /boot/vmlinuz is gzipped (17 MB -> 48 MB), and booti does not decompress,
# hence the unzip. Load the initramfs LAST: ${filesize} is whatever the most
# recent load set, and booti needs it to be the ramdisk's.
#
# NOT rdinit=/init.pmos. That file is created at FIT-assembly time by
# mkboot.sh/fogona-mkboot, because the GKI generic ramdisk clobbers /init on
# *that* path. No GKI ramdisk is involved here, so the on-disk initramfs has a
# plain /init -- and asking for init.pmos makes the kernel fail to exec init,
# fall through to mounting a real root, and panic with "VFS: unable to mount
# root fs on unknown-block(0,0)".
bootargs_disk=console=tty0 loglevel=7 panic=0 fbcon=map:0,font:6x10 clk_ignore_unused pmos.nosplash plymouth.enable=0 ignore_loglevel androidboot.slot_suffix=_a
bootdisk=load ${bootpart} ${loadaddr} vmlinuz && unzip ${loadaddr} ${kernel_addr_r} && load ${bootpart} ${fdt_addr_r} ${bootdtb} && load ${bootpart} ${ramdisk_addr_r} initramfs && setenv bootargs ${bootargs_disk} && booti ${kernel_addr_r} ${ramdisk_addr_r}:${filesize} ${fdt_addr_r}

# No FIT fallback. U-Boot reads the rootfs directly now, so nothing needs to
# be welded into our payload -- which is what let mkboot.sh, fogona-mkboot and
# fogona-flash-boot exist at all. If the rootfs boot fails we land in fastboot,
# the same recovery posture as before; what is given up is booting standalone
# from a broken rootfs, which in practice meant an unusable system anyway.

# Preferred path: standard extlinux. boot-deploy writes
# /boot/extlinux/extlinux.conf (deviceinfo_generate_extlinux_config) carrying
# the kernel, dtb, initramfs and the cmdline generated from
# /usr/lib/kernel-cmdline.d -- so none of that is hardcoded here any more.
#
# sysboot rather than `bootflow scan`: bootstd only enumerates devices that
# register a bootdev, and drivers/block/blkmap.c registers none, so bootstd
# cannot see /boot on this device at all. sysboot takes the device explicitly.
#
# No unzip step: booti decompresses on its own (cmd/booti.c calls
# image_decomp_type/image_decomp, and CONFIG_GZIP defaults to y), so
# extlinux's gzipped `kernel /vmlinuz` is handled.
# boot-deploy writes `menu title` into extlinux.conf, which makes U-Boot's pxe
# parser set prompt=1 (boot/pxe_utils.c, case T_MENU), and a prompting menu
# ignores `timeout` whenever input is already waiting: cread_line only honours
# its timeout `while (!tstc())`. The menu then reads an empty choice, prints
# " not found", sets its timeout to 0, and blocks for ever -- at a prompt this
# handset has no keyboard to answer. Recovering from that takes a fastboot
# flash from a host.
#
# `setenv stdin serial` narrows stdin to drop button-kbd, whose input is always
# pending because the PON block latches volume-down in hardware. It is kept
# because it costs nothing, but it is NOT a fix and was tested failing here:
# ABL leaves the geni UART unclocked, so serial RX floats and tstc() reports
# data on that source too. Do not treat it as a fallback.
#
# The only thing that prevents the hang is boot-deploy emitting `prompt 0`,
# which makes menu_get_choice() take menu_default_choice() without consulting
# stdin at all. Carried locally as 0001-extlinux-set-prompt-0.patch in the
# pmaports boot-deploy APKBUILD -- so an apk upgrade that replaced boot-deploy
# with an unpatched build would reintroduce the hang on the next kernel
# update. That patch needs to go upstream before extlinux can be the only
# boot path here.
bootextlinux=setenv stdin serial; sysboot ${bootpart} any ${loadaddr} /extlinux/extlinux.conf; setenv stdin serial,button-kbd

# ------------------------------------------------------------- EFI, on trial
# Direct `bootefi`, NOT `bootefi bootmgr`. bootmgr picks its payload from the
# BootOrder/Boot#### EFI variables, and this device has no variable store --
# every boot prints "File not found ubootefi.var" and "Failed to persist EFI
# variables". Loading the image here sidesteps the store entirely, which
# isolates the question worth answering first: does the EFI handover work on
# this hardware at all. If it does, the variable store and systemd-boot are a
# packaging problem; if it does not, they were never worth building.
#
# /boot/vmlinuz is gzipped and bootefi does not decompress -- unlike booti,
# which calls image_decomp itself -- so it is unzipped first. What comes out is
# a valid EFI application: arm64 kernels built with CONFIG_EFI_STUB carry a
# PE/COFF header, and this one does (it starts "MZ", with the arm64 "ARMd"
# magic at 0x38). CONFIG_EFI_STUB=y is set in our kernel.
#
# The initrd goes in bootefi's second argument rather than initrd= on the
# cmdline: EFI_LOAD_FILE2_INITRD (default y) installs Linux's LoadFile2
# protocol, and the stub then ignores any initrd= it is given.
#
# Passing the DTB explicitly is the point of the third argument. Under EFI
# U-Boot would otherwise hand over its OWN control DTB, which on fogona is the
# one appended to u-boot-fogona.bin -- a different file with different
# contents from the kernel's. That handover is the part most likely to break.
#
# The `:${ksize}` on the image address is REQUIRED, and its absence is not a
# size problem -- it changes which branch of do_bootefi() runs. Without a
# colon, bootefi does not look at the memory at all; it asks
# efi_get_image_parameters() for the address some earlier EFI-aware load
# recorded, compares it to the address given, and bails with
#
#     No UEFI binary known at <addr>
#
# `unzip` registers nothing with the EFI layer, so that comparison can never
# match and the PE header is never even examined. Supplying a size takes the
# other branch, which calls efi_clear_bootdev() and treats the address as a
# raw in-memory image. Observed on this handset before the size was added.
#
# ksize comes from ${filesize}, which `unzip` sets to the UNCOMPRESSED length
# (cmd/unzip.c stores what gunzip reports, and lib/gunzip.c sets that to the
# bytes written to the destination). It has to be saved immediately: each
# later `load` overwrites filesize.
#
# ${filesize} is set by the most recent load, so the initramfs is loaded LAST.
#
# bootargs_disk, not the generated cmdline: this tests the boot method, not the
# cmdline, so it reuses the one already proven on the bootdisk path. The marker
# is what makes /proc/cmdline say which of the three paths ran -- extlinux
# carries pmos_boot_uuid, bootdisk carries neither it nor the marker.
bootefi_test=load ${bootpart} ${loadaddr} vmlinuz && unzip ${loadaddr} ${kernel_addr_r} && setenv ksize ${filesize} && load ${bootpart} ${fdt_addr_r} ${bootdtb} && load ${bootpart} ${ramdisk_addr_r} initramfs && setenv bootargs ${bootargs_disk} pmos.boot_method=efi && bootefi ${kernel_addr_r}:${ksize} ${ramdisk_addr_r}:${filesize} ${fdt_addr_r}

# systemd-boot, the full EFI path. boot-deploy installs the app and its
# bootloader-spec entry once the systemd-boot package is present
# (add_systemd_boot()); before that it logs "systemd-boot EFI app or
# powervm-boot not found, skipping" and writes neither.
#
# Loaded by PATH, not via BootOrder: EFI/BOOT/BOOTAA64.EFI is the EFI
# removable-media fallback, found by convention, so no variable store is
# involved. That is why this works on a device that still reports
# "File not found ubootefi.var" on every boot.
#
# NO `:size` here, which is the exact OPPOSITE of bootefi_test above, for a
# reason worth keeping straight. `load` calls efi_set_bootdev() (fs/fs.c),
# registering the partition the file came from, so the bare form both finds
# its image and leaves systemd-boot a valid LoadedImage->DeviceHandle -- which
# is how systemd-boot locates /loader/entries. Passing a size takes the other
# branch, which calls efi_clear_bootdev(), and systemd-boot would then be
# unable to find its own configuration. bootefi_test needs the size precisely
# because its image comes out of `unzip`, which registers no bootdev at all.
#
# The EFI app is therefore loaded LAST, so the bootdev refers to it and not to
# the DTB.
#
# The DTB is still passed as a fallback. The loader entry carries its own
# `devicetree` line which supersedes this, but if that ever stops working the
# kernel gets its own DTB rather than U-Boot's control DTB.
#
# Requires an EFI-loadable kernel. /boot/vmlinuz is gzipped and systemd-boot
# does not decompress, so boot-deploy points the entry at vmlinuz.efi when one
# exists. device-motorola-fogona ships a boot-deploy hook that keeps that file
# in step with vmlinuz; CONFIG_EFI_ZBOOT=y is deliberately NOT used, because it
# would rename the PE to vmlinuz and leave booti -- and therefore extlinux and
# bootdisk -- with nothing bootable.
bootsdboot=load ${bootpart} ${fdt_addr_r} ${bootdtb} && load ${bootpart} ${loadaddr} /EFI/BOOT/BOOTAA64.EFI && bootefi ${loadaddr} ${fdt_addr_r}

# The boot chain, most standard first. Each step runs only if the one before it
# returned an error, and a successful boot never returns:
#
#   systemd-boot  the end state. bootloader-spec entries, and the path pmOS is
#                 standardising on; with it working, boot-deploy's generated
#                 configs stop being load-bearing here.
#   extlinux      boot-deploy's other generated config. Same kernel, DTB,
#                 initramfs and cmdline, without the EFI layer.
#   bootdisk      everything hardcoded in this file. Needs nothing generated at
#                 all, which is the point: it is what still boots when /boot is
#                 wrong.
#
# The failure this chain cannot catch is any of them HANGING rather than
# returning, since `&&`/`;` only see exit status. That is not hypothetical --
# extlinux did exactly that before boot-deploy emitted `prompt 0`. The escape
# is the 2 s menu window and entry 12 below, which is why entry 12 must keep
# existing and must stay on the hardcoded path.
bootcmd=echo == boot: systemd-boot ==; run bootsdboot; echo == systemd-boot failed, trying extlinux ==; run bootextlinux; echo == extlinux failed, trying rootfs ==; run bootdisk; echo == all boot paths failed ==; pause; run menucmd

# fogona: pmOS flashes its rootfs image into the Android `userdata` GPT
# partition, and that image carries its own nested GPT (ESP = /boot, plus
# root). U-Boot only parses a partition table at the start of a *device*, so
# blkmap is used to expose userdata's extent as one.
#
# userdata is on UFS LUN 4 here, NOT the scsi 0 this file assumes elsewhere.
#
# The 0x prefixes are load-bearing. `part start`/`part size` return hex with
# no prefix (e.g. 19a200), and blkmap parses its device number and block
# number with dectoul() -- decimal. Unprefixed, 19a200 stops at the 'a' and
# yields 19, so the map silently lands at block 0x13 and the inner GPT reads
# as "Unknown partition table type 0". Wrong, plausible, and three steps
# removed from the symptom.
rootdev=scsi 4
blkmap_find=part start ${rootdev} userdata ustart; part size ${rootdev} userdata usize
blkmap_make=blkmap create root; blkmap map root 0 0x${usize} linear ${rootdev} 0x${ustart}
blkmap_init=run blkmap_find; run blkmap_make

# fogona: where pmOS is. It can live on the microSD card -- a plain disk
# image, /boot a partition of its own -- or in UFS `userdata` through the
# blkmap above; the handset may also dual-boot stock from UFS with pmOS on
# SD. Nothing after this names either: preboot looks for pmOS's /boot, SD
# first, and every boot path loads from ${bootpart}, the partition it found.
#
# The marker is boot-deploy's own output, loader/entries/pmos.conf
# (systemd-boot) or extlinux/extlinux.conf; no other ESP carries either.
# ${cand} holds "<iface> <dev>:<part>" and splits into two arguments when
# expanded, as ${rootdev} does above.
bootfind_try=if test -z "${bootpart}"; then if test -e ${cand} /loader/entries/pmos.conf || test -e ${cand} /extlinux/extlinux.conf; then setenv bootpart ${cand}; echo == pmOS /boot on ${cand} ==; fi; fi
bootfind_mmc=for d in 0 1; do for p in 1 2 3 4; do setenv cand mmc ${d}:${p}; run bootfind_try; done; done
bootfind_ufs=run blkmap_init; setenv cand blkmap 0:1; run bootfind_try
bootfind=setenv bootpart; run bootfind_mmc; if test -z "${bootpart}"; then run bootfind_ufs; fi; if test -z "${bootpart}"; then echo == no pmOS /boot found on SD or UFS ==; fi
preboot=scsi scan; run bootfind

# ------------------------------------------------------- fogona menu overrides
# Later assignments win, so these replace the generic entries above.
#
# 0: the generic entry is `bootefi bootmgr`, which does nothing here. THIS is
#    the entry the menu auto-selects when the bootdelay expires, so it is the
#    normal boot -- bootcmd is NOT what runs on an unattended boot, and editing
#    bootcmd alone changes nothing.
#
#    Same chain as bootcmd: systemd-boot, then extlinux, then bootdisk, each
#    tried only if the previous one returned an error.
#
#    The failure a chain cannot catch is a step HANGING instead of returning,
#    because `;` only sees exit status. extlinux did exactly that before
#    boot-deploy emitted `prompt 0`: its pxe menu blocked at a prompt with no
#    keyboard to answer, and nothing after it ever ran. systemd-boot has its own
#    version of this -- it waits for a keypress when it cannot load a kernel,
#    and whether its EFI text input reaches button-kbd through U-Boot is
#    untested here.
#
#    So the 2 s AUTOBOOT_MENU_SHOW window and entry 12 are the real safety net,
#    not the fallbacks in this line. Entry 12 must keep existing and must stay
#    on the hardcoded path.
# 12: the old hardcoded rootfs boot, and the escape hatch. Do NOT delete it --
#     nor bootdisk, nor bootargs_disk -- while anything above it is generated
#     by boot-deploy, which is to say not until `prompt 0` is upstream and
#     systemd-boot has a few kernel updates behind it.
# 13: EFI direct (bootefi on the kernel), selectable by hand.
# 14: systemd-boot alone, selectable by hand, for testing it without the
#     fallbacks masking a failure.
# 15: extlinux alone, same reason.
# 2: the generic UMS entry exports `scsi 0`, which on this device is the 16 MB
#    LUN 0, not storage. userdata is LUN 4; `blkmap 0` is the rootfs image
#    inside it, which is usually what you actually want to export.
bootmenu_0=Boot pmOS=echo == boot: systemd-boot ==; run bootsdboot; echo == systemd-boot failed, trying extlinux ==; run bootextlinux; echo == extlinux failed, trying rootfs ==; run bootdisk; pause
bootmenu_12=Boot pmOS from rootfs (hardcoded)=run bootdisk; pause
bootmenu_13=Boot pmOS via EFI direct (test)=echo == boot: efi ==; run bootefi_test; echo == efi failed ==; pause
bootmenu_14=Boot pmOS via systemd-boot only (test)=echo == boot: systemd-boot ==; run bootsdboot; echo == systemd-boot failed ==; pause
bootmenu_15=Boot pmOS via extlinux only (test)=echo == boot: extlinux ==; run bootextlinux; echo == extlinux failed ==; pause
bootmenu_2=Export rootfs over USB (UMS)=echo "Press any key to exit UMS mode"; ums 0 blkmap 0
bootmenu_11=Export whole UFS LUN4 over USB (UMS)=echo "Press any key to exit UMS mode"; ums 0 scsi 4
