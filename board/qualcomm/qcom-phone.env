bootdelay=0
# fogona: do NOT retry. bootretry re-runs bootcmd every second, which scrolls
# the failure messages off the panel before they can be read.
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
fastboot=fastboot -l $fastboot_addr_r usb 0

# Always probe for UFS storage, though it should be done by board code.

# Shortcut to enable USB serial gadget and disable bootretry
serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

# bootretry will run this command over and over, if we fail once
# then bail out to the boot menu instead (with a pause to read
# the error message)
bootcmd=bootefi bootmgr; pause; run menucmd

# When entering the menu (either from button press or failed boot)
# remap bootcmd so it will re-open the menu and we won't get stuck
# at the console with no way to type
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Pause is used so the output can be read on the display
bootmenu_0=Boot=bootefi bootmgr; pause
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_3=Enable fastboot mode=echo "Press any key to exit fastboot mode"; run fastboot
# Disabling bootretry means we'll just drop the shell
bootmenu_4=Drop to shell=setenv bootretry -1
bootmenu_5=Reset device=reset
bootmenu_6=Dump clocks=clk dump; pause
bootmenu_7=Dump environment=printenv; pause
bootmenu_8=Board info=bdinfo; pause
bootmenu_9=Dump bootargs=fdt addr $fdt_addr_r; fdt print /chosen bootargs; pause
bootmenu_10=Power off=poweroff

# Allow holding the volume down button while U-Boot loads to enter
# the boot menu
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd

# fogona bringup: no serial console and only one key on TLMM, so come up as a
# USB fastboot device unconditionally. Gives a control channel plus a log dump
# via `fastboot oem console` (CONSOLE_RECORD is enabled above).
# fogona bringup: boot the FIT that ABL loaded as the boot image's ramdisk.
#
# NOT ramdisk_addr_r -- board_late_init() sets that to an lmb_alloc'd scratch
# region for U-Boot to load things INTO, unrelated to where the previous stage
# put anything. ABL records the real location in the device tree it hands us,
# as /chosen/linux,initrd-start, so read it from our own fdt.
#
# This route needs no storage, no USB and no regulator control, none of which
# U-Boot has on khaje (its rails are RPM/SMD; U-Boot only ships RPMh).
# ---------------------------------------------------------------- boot paths
# Tried in order: rootfs, then the welded FIT, then fastboot. Each falls
# through to the next only if it fails; a successful boot never returns.
#
# `&&` throughout the load chains, deliberately: CONFIG_HUSH_PARSER makes `;`
# a plain separator that does NOT stop on failure, so a `;` chain would run
# booti on a half-loaded kernel.
fdtfile=sm6225-motorola-fogona-icnl9916c.dtb

# Primary: kernel, initramfs and DTB from pmOS's /boot -- the ESP
# subpartition inside userdata, reached through the blkmap set up in preboot.
#
# /boot/vmlinuz is gzipped (17 MB -> 48 MB), and booti does not decompress,
# hence the unzip. Load the initramfs LAST: ${filesize} is whatever the most
# recent load set, and booti needs it to be the ramdisk's.
#
# NOT rdinit=/init.pmos. That file is created at FIT-assembly time by
# mkboot.sh/fogona-mkboot, because the GKI generic ramdisk clobbers /init on
# *that* path. No GKI ramdisk is involved here, so the on-disk initramfs has a
# plain /init -- and asking for init.pmos makes the kernel fail to exec init,
# fall through to mounting a real root, and panic with "VFS: unable to mount
# root fs on unknown-block(0,0)".
bootargs_disk=console=tty0 loglevel=7 panic=0 fbcon=map:0,font:6x10 clk_ignore_unused pmos.nosplash plymouth.enable=0 ignore_loglevel androidboot.slot_suffix=_a
bootdisk=load blkmap 0:1 ${loadaddr} vmlinuz && unzip ${loadaddr} ${kernel_addr_r} && load blkmap 0:1 ${fdt_addr_r} ${fdtfile} && load blkmap 0:1 ${ramdisk_addr_r} initramfs && setenv bootargs ${bootargs_disk} && booti ${kernel_addr_r} ${ramdisk_addr_r}:${filesize} ${fdt_addr_r}

# No FIT fallback. U-Boot reads the rootfs directly now, so nothing needs to
# be welded into our payload -- which is what let mkboot.sh, fogona-mkboot and
# fogona-flash-boot exist at all. If the rootfs boot fails we land in fastboot,
# the same recovery posture as before; what is given up is booting standalone
# from a broken rootfs, which in practice meant an unusable system anyway.
bootcmd=echo == boot: rootfs ==; run bootdisk; echo == rootfs boot failed, dropping to fastboot ==; run fastboot

# fogona: pmOS flashes its rootfs image into the Android `userdata` GPT
# partition, and that image carries its own nested GPT (ESP = /boot, plus
# root). U-Boot only parses a partition table at the start of a *device*, so
# blkmap is used to expose userdata's extent as one.
#
# userdata is on UFS LUN 4 here, NOT the scsi 0 this file assumes elsewhere.
#
# The 0x prefixes are load-bearing. `part start`/`part size` return hex with
# no prefix (e.g. 19a200), and blkmap parses its device number and block
# number with dectoul() -- decimal. Unprefixed, 19a200 stops at the 'a' and
# yields 19, so the map silently lands at block 0x13 and the inner GPT reads
# as "Unknown partition table type 0". Wrong, plausible, and three steps
# removed from the symptom.
rootdev=scsi 4
blkmap_find=part start ${rootdev} userdata ustart; part size ${rootdev} userdata usize
blkmap_make=blkmap create root; blkmap map root 0 0x${usize} linear ${rootdev} 0x${ustart}
blkmap_init=run blkmap_find; run blkmap_make
preboot=scsi scan; run blkmap_init
