# fogona bringup: come up as a USB fastboot device unconditionally.
#
# There is no serial console (ABL leaves the geni UART unclocked) and the only
# key on TLMM is volume-up, so an interactive prompt is impractical. U-Boot's
# fastboot gives both a control channel and, with CONSOLE_RECORD, a log dump
# via `fastboot oem console`.
# bootcmd itself lives in qcom-phone.env (rootfs boot, then fastboot); this
# Kconfig default is only a fallback for builds without that fragment.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="run bootcmd"
CONFIG_BOOTDELAY=2

# Tiny console font: the default 16x32 gives 45x50 chars on fogona's 720x1600
# panel, so anything verbose scrolls off. 4x6 gives 180x266.
# 4x6 was legible but too small to read comfortably; 6x8 gives 120x200.
# 6x8 gives 120x200 on the 720x1600 panel but is too small to read on the
# device; 8x16 gives 90x100 and is legible. SUN12X22 and 16X32 are larger
# still if ever needed.
CONFIG_VIDEO_FONT_8X16=y
# CONFIG_VIDEO_FONT_6X8 is not set
# CONFIG_VIDEO_FONT_4X6 is not set
# CONFIG_VIDEO_FONT_16X32 is not set

# A panic must reboot, not hang. With PANIC_HANG=y a U-Boot that starts and
# then dies is indistinguishable from one that never ran -- the Motorola logo
# just sits there and even `fastboot devices` cannot tell you, because U-Boot
# hangs instead of falling back to fastboot. Rebooting is observable, and
# recoverable without holding Power for ten seconds.
# CONFIG_PANIC_HANG is not set

# 24 KiB (the value qcom-phone.config leaves) fills up, and the Kconfig is
# explicit that once it does "no more data will be recorded" -- silently. That
# swallowed driver diagnostics for several debugging rounds, because a full
# recorder is indistinguishable from a silent driver. 256 KiB leaves room.
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x40000

# pmOS installs the rootfs into the Android `userdata` GPT partition as an
# image with its own nested partition table (boot + root subpartitions).
# U-Boot's block layer only parses a partition table at the start of a
# *device*, not recursively inside a partition, so userdata looks like an
# unformatted blob. blkmap maps that extent as its own block device, which
# U-Boot then parses normally. This is the same mechanism Tauchgang uses for
# ex-Android devices.
CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y

# sysboot, to boot from boot-deploy's /boot/extlinux/extlinux.conf. CMD_SYSBOOT
# has no Kconfig default, so it must be asked for. BOOTMETH_EXTLINUX (default y)
# covers bootstd's version of the same thing, but bootstd never sees this
# device: blkmap registers no bootdev, so `bootflow scan` finds nothing and
# sysboot -- which takes the device explicitly -- is the only route.
CONFIG_CMD_SYSBOOT=y

# Point U-Boot's own `fastboot flash` at UFS, not at an eMMC this board does
# not have. qcom-phone.config leaves the Kconfig choice on FASTBOOT_FLASH_MMC
# with FASTBOOT_FLASH_MMC_DEV=0, so every `fastboot flash` looks for `mmc 0`
# and finds nothing. fb_block.c resolves the target as
# blk_get_device(INTERFACE_NAME, DEVICE_ID) and then part_get_info_by_name(),
# so this makes `fastboot flash userdata` land on the real GPT partition.
#
# Device 4, not 0: userdata is on UFS LUN 4 here. qcom-phone.env says the same
# thing in its own comment and uses `rootdev=scsi 4` for the blkmap it builds
# in preboot -- scsi 0 is a different LUN and holds none of this.
#
# Why this matters: ABL refuses `fastboot flash userdata` outright
# ("flash permission denied") and allows only erase -- Motorola's own
# flashfile.xml never flashes userdata either. U-Boot drives UFS itself, so
# its fastboot is not bound by that policy and is the one route that can write
# a rootfs without erasing first.
# CONFIG_FASTBOOT_FLASH_MMC is not set
CONFIG_FASTBOOT_FLASH_BLOCK=y
CONFIG_FASTBOOT_FLASH_BLOCK_INTERFACE_NAME="scsi"
CONFIG_FASTBOOT_FLASH_BLOCK_DEVICE_ID=4

# Show the boot menu during the autoboot delay rather than a bare countdown.
# All three side keys work now (volume-up on PMIC GPIO 5, power and
# volume-down on the PON block), and BUTTON_REMAP_PHONE_KEYS maps them to
# Up/Down/Enter, so the menu is navigable. Timing out selects bootmenu_0,
# which is the normal rootfs boot.
#
# This is the postmarketOS/Tauchgang convention: a failed boot lands in a menu
# rather than falling through to another kernel -- and it matters more here
# because there is no longer a FIT fallback.
CONFIG_AUTOBOOT_MENU_SHOW=y
