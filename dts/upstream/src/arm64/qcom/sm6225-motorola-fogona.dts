// SPDX-License-Identifier: BSD-3-Clause
/*
 * U-Boot board file: Motorola Moto G Play (2024) -- "fogona", SM6225 (khaje).
 *
 * Deliberately includes sm6115.dtsi and claims the sm6115 compatibles, because
 * U-Boot's Qualcomm support has clock-sm6115.c and pinctrl-sm6115.c and no
 * sm6225 equivalents. khaje is a bengal derivative, and mainline Linux's
 * gcc-sm6115 was confirmed to bind on this silicon (measured: it claimed the
 * clock controller at 0x1400000 and probed), so the same bet applies here.
 *
 * msm-id is measured, not inherited: /sys/devices/soc0/soc_id = 518 = 0x206,
 * revision 1.0. fogona ships two base DTBs differing only in this property
 * (0x24a and 0x206); this unit is 0x206.
 *
 * The framebuffer address is the same 0x5c000000 the fxtec sm6115 board uses,
 * confirmed on fogona from the live device tree
 * (splash_region@5c000000, 0xf00000) -- the panel is 720x1600 rather than
 * 1080x2160.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include "sm6115.dtsi"

/ {
	model = "Motorola Moto G Play (2024)";
	compatible = "motorola,fogona", "qcom,sm6115";
	chassis-type = "handset";

	qcom,msm-id = <0x206 0x10000>;

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer0: framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x5c000000 0x0 (720 * 1600 * 4)>;
			width = <720>;
			height = <1600>;
			stride = <(720 * 4)>;
			format = "a8r8g8b8";
			clocks = <&gcc GCC_DISP_HF_AXI_CLK>;
		};
	};
	/*
	 * UFS supplies. fogona's real rails are pm6125 LDOs behind RPM/SMD,
	 * which U-Boot has no driver for -- and ABL has already powered them,
	 * since it boots the device from UFS. An always-on fixed regulator is
	 * an honest stand-in for bringup.
	 */
	vreg_ufs_bringup: regulator-ufs-bringup {
		compatible = "regulator-fixed";
		regulator-name = "vreg_ufs_bringup";
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * Volume-up is the only key on TLMM (gpio 5); power and volume-down
	 * hang off the PMIC. One key is enough for U-Boot's "press any key".
	 */
	gpio-keys {
		compatible = "gpio-keys";

		key-volume-up {
			label = "Volume Up";
			gpios = <&tlmm 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};
	};
};

&ufs_mem_hc {
	vcc-supply = <&vreg_ufs_bringup>;
	vccq2-supply = <&vreg_ufs_bringup>;
	vdd-hba-supply = <&vreg_ufs_bringup>;
	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_ufs_bringup>;
	vdda-pll-supply = <&vreg_ufs_bringup>;
	status = "okay";
};

/*
 * USB. fogona is USB 2.0 only -- Motorola's schematics break out USB0_CC1/CC2
 * to testpoints but carry no SBU, and USB0_SS_* / USB0_DP_AUX_* have no
 * cross-sheet routing at all. So enable the HS phy and pin dwc3 to
 * high-speed, dropping the superspeed phy that sm6115.dtsi expects; otherwise
 * dwc3 waits on a qmpphy this board does not have.
 *
 * Supplies come from the bringup fixed regulator for the same reason as UFS:
 * the real rails are pm6125 LDOs behind RPM/SMD, and ABL has already brought
 * them up (it serves fastboot over this very port).
 */
&usb {
	status = "okay";
};

&usb_dwc3 {
	phys = <&usb_hsphy>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	dr_mode = "peripheral";
};

/*
 * khaje's USB HS PHY is a Synopsys femto v2, NOT the QUSB2 that U-Boot's
 * sm6115.dtsi describes at this address.
 *
 * Including sm6115.dtsi is deliberate -- U-Boot has clock-sm6115.c and
 * pinctrl-sm6115.c and no sm6225 equivalents. That bet holds for clocks and
 * pinctrl. It does NOT hold for the USB PHY: bengal has a QUSB2 at 0x1613000,
 * khaje has a femto. Same address, same 0x180 window, different block.
 *
 * Inheriting "qcom,sm6115-qusb2-phy" binds phy-qcom-qusb2.c, which pokes
 * QUSB2 PLL registers that do not exist in this layout and fails with:
 *
 *     QUSSB2PHY pll lock failed; status reg = 0
 *     qcom-qusb2-phy phy@1613000: PHY: Failed to power on ...: -16
 *
 * Linux's own sm6225.dtsi and SCOS100's U-Boot sm6225.dtsi both declare
 * "qcom,sm6375-usb-hs-phy", "qcom,usb-snps-hs-7nm-phy" here, arrived at
 * independently. Override to the generic fallback, which
 * phy-qcom-snps-femto-v2.c matches and CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2
 * already builds.
 *
 * That driver takes only reg + reset -- no clocks, no supplies -- so this
 * also sidesteps both U-Boot gaps on khaje: no SMD/RPM regulator driver, and
 * rpmcc served by clk-stub. The supplies below are now vestigial; nothing
 * reads them. They are kept as documentation of the rails.
 */
&usb_hsphy {
	compatible = "qcom,usb-snps-hs-7nm-phy";
	vdd-supply = <&vreg_ufs_bringup>;
	vdda-pll-supply = <&vreg_ufs_bringup>;
	vdda-phy-dpdm-supply = <&vreg_ufs_bringup>;
	status = "okay";
};

/*
 * khaje reserves GPIOs 14-17. From Qualcomm's own downstream driver:
 *
 *   static const int khaje_reserved_gpios[] = { 14, 15, 16, 17, -1 };
 *       -- drivers/pinctrl/qcom/pinctrl-khaje.c
 *
 * Touching them during gpio init is what crashes TLMM on this SoC; it cost
 * another porter a day ("it would always crash at gpio init ... just had to
 * add the dummy pins to the reserved list and it boots"). ngpios stays 114,
 * which Qualcomm's driver, mainline pinctrl-sm6115 and the unmerged
 * pinctrl-sm6225 all agree on -- the datasheet's "GPIOs (125)" counts
 * something else, most likely PMIC GPIOs.
 */
&tlmm {
	gpio-reserved-ranges = <14 4>;
};
